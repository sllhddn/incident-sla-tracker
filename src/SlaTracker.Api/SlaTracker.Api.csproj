<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>SlaTracker.Api</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating patch versions: the first CI run resolves the latest 10.0.x. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versioned T-SQL scripts ship inside the assembly and run at start-up (see SchemaMigrator). -->
    <EmbeddedResource Include="Data\Scripts\*.sql" />
  </ItemGroup>
</Project>
